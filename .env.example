# Copy to .env for local development. Railway takes these as service variables.
# Everything here is optional — the collector runs on free public endpoints
# with no keys at all, just at a lower polling rate.

# Port the collector listens on. Railway injects this automatically.
PORT=8080
HOST=0.0.0.0

# Jupiter. Without a key the collector uses https://lite-api.jup.ag (rate
# limited, ~1 depth ladder per 5s). With a key it switches to https://api.jup.ag
# and can poll every second. Free tier: 25M credits/month — https://portal.jup.ag
JUPITER_API_KEY=

# Helius. Enables the per-swap feed (PLAN.md §4.5 tier B) by subscribing to the
# vault accounts of the top SOL/USDC pools. Without it the collector derives
# pressure from price ticks alone. Free tier: 5 concurrent WS connections.
# https://dashboard.helius.dev
HELIUS_API_KEY=

# WebSocket keepalive. Railway's edge drops idle connections around 60s.
WS_HEARTBEAT_MS=30000

# Dev only: where the Vite dev server proxies /ws and /healthz.
COLLECTOR_URL=http://localhost:8080
