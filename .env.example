# Copy to .env for local development. Railway takes these as service variables.
# Everything here is optional — the collector runs on free public endpoints
# with no keys at all, just at a lower polling rate.

# Port the collector listens on. Railway injects this automatically.
PORT=8080
HOST=0.0.0.0

# Jupiter key from https://portal.jup.ag
#
# A key on its own changes nothing. Jupiter's published rates (2026-08-11):
#
#   keyless api.jup.ag    0.5 RPS
#   free plan + key       1   RPS   <- same as the keyless lite host already gives
#   developer ($25/mo)    10  RPS
#   launch                50  RPS
#
# Measured: keyless lite-api.jup.ag sustains ~60/min and 429s around 125/min,
# which is the free plan's 1 RPS. So a free key is worth nothing here, and the
# collector stays on the slow cadence unless a paid plan says otherwise.
JUPITER_API_KEY=

# Which plan the key is on: keyless | free | developer | launch | pro.
# Defaults to `free` when a key is set, `keyless` when it is not. Nothing in
# Jupiter's API reports the plan, so it has to be declared — and declaring one
# the key does not have just gets the collector throttled.
#
#   free / keyless   price every 2s, liquidity curve every 45s
#   developer and up price every 1s, liquidity curve every 10s
JUPITER_PLAN=

# Helius. No longer needed: datapi.jup.ag/v1/txs turned out to serve real
# per-swap flow for free, which is what Helius was going to be for. Kept because
# a websocket push would still beat polling if the swap feed ever gets too slow.
# https://dashboard.helius.dev
HELIUS_API_KEY=

# WebSocket keepalive. Railway's edge drops idle connections around 60s.
WS_HEARTBEAT_MS=30000

# Dev only: where the Vite dev server proxies /ws and /healthz.
COLLECTOR_URL=http://localhost:8080
