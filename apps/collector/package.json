{
  "name": "@sol-warzone/collector",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Single upstream consumer for Jupiter data + WebSocket fan-out",
  "main": "./dist/index.js",
  "scripts": {
    "prebuild": "npm run build -w @sol-warzone/protocol && npm run build -w @sol-warzone/web",
    "build": "tsc --build tsconfig.build.json",
    "clean": "tsc --build tsconfig.build.json --clean",
    "dev": "node --env-file-if-exists=../../.env --watch --experimental-strip-types src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js"
  },
  "dependencies": {
    "@sol-warzone/protocol": "*",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1"
  }
}
