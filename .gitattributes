# Keep LF in the working copy on every platform. Prettier is configured with
# endOfLine: lf, so letting git hand out CRLF would fail `npm run format:check`
# on a fresh Windows clone.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.webp binary
*.ico binary
*.glb binary
*.gltf binary
*.ktx2 binary
*.ogg binary
*.mp3 binary
*.wav binary
*.woff2 binary
